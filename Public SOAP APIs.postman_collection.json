		{
			"name": "Book ISBN Numbers DZ SOAP",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"ISBN13 is valid\", function () {",
									"    var xmlData = pm.response.text();",
									"    var jsonData = xml2Json(xmlData);",
									"    pm.expect(jsonData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result']).to.eql(\"true\");",
									"});",
									"",
									"pm.test(\"Response should contain 'true' for valid ISBN13\", function () {",
									"    pm.response.to.have.body('<m:IsValidISBN13Result>true</m:IsValidISBN13Result>');",
									"});",
									"",
									"pm.test(\"Response body contains IsValidISBN13Result\", function () {",
									"    var xmlData = pm.response.text();",
									"    pm.expect(xmlData).to.include(\"<m:IsValidISBN13Result>\");",
									"});",
									"",
									"pm.test(\"Response contains soap:Envelope and soap:Body\", function () {",
									"    var xmlData = pm.response.text();",
									"    pm.expect(xmlData).to.include(\"<soap:Envelope>\");",
									"    pm.expect(xmlData).to.include(\"<soap:Body>\");",
									"});",
									"",
									"pm.test(\"Response encoding should be UTF-8\", function () {",
									"    pm.response.to.have.header(\"Content-Type\", /charset=utf-8/);",
									"});",
									"",
