	"item": [
		{
			"name": "Is Valid ISBN13 Number Copy",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"ISBN13 is valid\", function () {",
							"    var xmlData = pm.response.text();",
							"    var jsonData = xml2Json(xmlData);",
							"    pm.expect(jsonData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result']).to.eql(\"true\");",
							"});",
							"",
							"pm.test(\"Response should contain 'true' for valid ISBN13\", function () {",
							"    pm.response.to.have.body('<m:IsValidISBN13Result>true</m:IsValidISBN13Result>');",
							"});",
							"",
							"pm.test(\"Response body contains IsValidISBN13Result\", function () {",
							"    var xmlData = pm.response.text();",
							"    pm.expect(xmlData).to.include(\"<m:IsValidISBN13Result>\");",
							"});",
							"",
							"pm.test(\"Response encoding should be UTF-8\", function () {",
							"    pm.response.to.have.header(\"Content-Type\", /charset=utf-8/);",
							"});",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content-Type should be text/xml\", function () {",
							"    pm.response.to.have.header(\"Content-Type\", /text\\/xml/);",
							"});",
							"",
							"pm.test(\"IsValidISBN13Result is true\", function () {",
							"    var xmlData = pm.response.text();",
							"    var jsonData = xml2Json(xmlData);",
							"    var result = jsonData['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result'];",
							"    pm.expect(result).to.eql(\"true\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				},
				"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
			},
			"response": []
		},
