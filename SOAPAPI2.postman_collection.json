{
	"info": {
	  "_postman_id": "abcd1234-5678-9101-1121-314151617181",
	  "name": "SOAPAPI2 Tests",
	  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
	  {
		"name": "Is Valid ISBN13 Number Copy",
		"request": {
		  "method": "POST",
		  "url": "http://webservices.daehosting.com/services/isbnservice.wso",
		  "body": {
			"mode": "raw",
			"raw": "<isbnRequest><isbn>9781234567890</isbn></isbnRequest>"
		  },
		  "header": [
			{
			  "key": "Content-Type",
			  "value": "application/xml"
			}
		  ]
		},
		"response": [],
		"event": [
		  {
			"listen": "test",
			"script": {
			  "exec": [
				"pm.test('ISBN13 should be valid', function () {",
				"    pm.response.to.have.status(200);",
				"    var jsonData = pm.response.json();",
				"    pm.expect(jsonData.isbn13).to.be.a('string').that.has.lengthOf(13);",
				"});"
			  ],
			  "type": "text/javascript"
			}
		  }
		]
	  },
	  {
